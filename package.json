{
  "name": "@liuhange/dsh-client-deliverable-pipeline",
  "version": "0.1.1",
  "description": "Markdown to client-grade printable HTML report inside DSH: cover page, brand color, TOC, print pagination rules, A4 output. Markdown 转客户级可打印 HTML 报告，浏览器 Ctrl+P 直接导出 PDF。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "markdown",
    "report",
    "print",
    "pdf",
    "deliverable",
    "html",
    "客户报告",
    "交付"
  ],
  "homepage": "https://github.com/liuhange789/dsh-client-deliverable-pipeline#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liuhange789/dsh-client-deliverable-pipeline.git"
  },
  "bugs": {
    "url": "https://github.com/liuhange789/dsh-client-deliverable-pipeline/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/build.mjs && node --test test/host.test.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.7 <0.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/marked": "^4.3.2",
    "@types/node": "^22.10.2",
    "esbuild": "^0.25.0",
    "marked": "^4.3.0",
    "typescript": "^5.7.3"
  }
}
